# TrustWallet Backend Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
DATABASE_URL=sqlite:///./wallet_app.db

# Supabase Configuration (Primary Database Option)
# Get these values from your Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-database-password

# Alternative: Direct PostgreSQL URL for Supabase
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Settings
DEBUG=True
APP_NAME=TrustWallet MVP Backend
APP_VERSION=1.0.0

# CORS Settings (comma-separated)
ALLOWED_ORIGINS=*
# For production: ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Fraud Detection Settings
MAX_TRANSACTION_AMOUNT=100000
HIGH_VALUE_THRESHOLD=50000
HIGH_VALUE_TIME_WINDOW_MINUTES=5
MAX_HIGH_VALUE_TRANSACTIONS=3

# NID Validation Settings
ENABLE_NID_API_VALIDATION=False
# NID_API_URL=https://api.example.gov.bd/nid/verify
# NID_API_KEY=your-api-key

# Logging
LOG_LEVEL=INFO

# Email Settings (for future notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password